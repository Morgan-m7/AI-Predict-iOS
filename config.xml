<?xml version='1.0' encoding='utf-8'?>
<widget id="com.aipredict.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>AI智能预测</name>
    <description>AI 智能预测引擎 - 智能预测与数据分析平台</description>
    <author email="support@aipredict.app" href="https://morgan666.top">
        AI Predict Team
    </author>
    
    <!-- 应用启动页面 -->
    <content src="index.html" />
    
    <!-- 允许访问所有外部链接 -->
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    
    <!-- iOS 特定配置 -->
    <platform name="ios">
        <!-- 启动后隐藏状态栏 -->
        <preference name="StatusBarOverlaysWebView" value="false" />
        <preference name="StatusBarStyle" value="lightcontent" />
        <preference name="StatusBarBackgroundColor" value="#1a1a2e" />
        
        <!-- 应用启动配置 -->
        <preference name="AutoHideSplashScreen" value="true" />
        <preference name="FadeSplashScreen" value="true" />
        <preference name="FadeSplashScreenDuration" value="0.5" />
        <preference name="ShowSplashScreenSpinner" value="false" />
        
        <!-- 全屏配置 -->
        <preference name="fullscreen" value="false" />
        
        <!-- 目标设备 -->
        <preference name="target-device" value="universal" />
        <preference name="deployment-target" value="13.0" />
        
        <!-- 图标资源 -->
        <icon src="www/img/icon.png" />
        <icon src="www/img/icon-20x20.png" platform="ios" width="20" height="20" />
        <icon src="www/img/icon-29x29.png" platform="ios" width="29" height="29" />
        <icon src="www/img/icon-40x40.png" platform="ios" width="40" height="40" />
        <icon src="www/img/icon-58x58.png" platform="ios" width="58" height="58" />
        <icon src="www/img/icon-60x60.png" platform="ios" width="60" height="60" />
        <icon src="www/img/icon-76x76.png" platform="ios" width="76" height="76" />
        <icon src="www/img/icon-80x80.png" platform="ios" width="80" height="80" />
        <icon src="www/img/icon-87x87.png" platform="ios" width="87" height="87" />
        <icon src="www/img/icon-120x120.png" platform="ios" width="120" height="120" />
        <icon src="www/img/icon-152x152.png" platform="ios" width="152" height="152" />
        <icon src="www/img/icon-167x167.png" platform="ios" width="167" height="167" />
        <icon src="www/img/icon-180x180.png" platform="ios" width="180" height="180" />
        <icon src="www/img/icon-1024x1024.png" platform="ios" width="1024" height="1024" />
        
        <!-- 启动画面 -->
        <splash src="www/img/icon-1024x1024.png" platform="ios" width="1024" height="1024" />
    </platform>
    
    <!-- Android 特定配置（兼容） -->
    <platform name="android">
        <preference name="SplashScreenDelay" value="3000" />
    </platform>
</widget>
